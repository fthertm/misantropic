/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'nonce-Y2xvdWRmbGFyZS1qc2Q='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://matrix.misantropic.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Service worker her zaman güncel kontrol edilir
/sw.js
  Cache-Control: no-cache

# İçerik ve manifest: her açılışta ETag ile doğrulanır (SW zaten arka planda yeniler)
/content.json
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Yazı tipi değişmez; uzun süre önbellekte kalır
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Matrix keşif dosyaları
/.well-known/matrix/*
  Access-Control-Allow-Origin: *
  Content-Type: application/json
